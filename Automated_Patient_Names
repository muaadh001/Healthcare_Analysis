 #### Create Realistic Standard for Race, Gender and Primary Languages to match

def generate_ethnic_name(race_ethnicity, gender, primary_language):
    if race_ethnicity == "Arab" and primary_language == "Arabic":
        if gender == "Male":
            first_name = random.choice(ethnic_names['Arab']['male_names'])
        else:
            first_name = random.choice(ethnic_names['Arab']['female_names'])
        last_name = random.choice(ethnic_names['Arab']['last_names'])
    elif race_ethnicity == "White" and primary_language == "English":
        if gender == "Male":
            first_name = random.choice(ethnic_names['White']['male_names'])
        else:
            first_name = random.choice(ethnic_names['White']['female_names'])
        last_name = random.choice(ethnic_names['White']['last_names'])
    elif race_ethnicity == "Black" and primary_language == "English":
        if gender == "Male":
            first_name = random.choice(ethnic_names['Black']['male_names'])
        else:
            first_name = random.choice(ethnic_names['Black']['female_names'])
        last_name = random.choice(ethnic_names['Black']['last_names'])
    elif race_ethnicity == "Asian" and primary_language == "Mandarin":
        if gender == "Male":
            first_name = random.choice(ethnic_names['Asian']['male_names'])
        else:
            first_name = random.choice(ethnic_names['Asian']['female_names'])
        last_name = random.choice(ethnic_names['Asian']['last_names'])
    elif race_ethnicity == "Hispanic" and primary_language == "Spanish":
        if gender == "Male":
            first_name = random.choice(ethnic_names['Hispanic']['male_names'])
        else:
            first_name = random.choice(ethnic_names['Hispanic']['female_names'])
        last_name = random.choice(ethnic_names['Hispanic']['last_names'])
    elif race_ethnicity == "White" and primary_language == "French":
        if gender == "Male":
            first_name = random.choice(ethnic_names['French']['male_names'])
        else:
            first_name = random.choice(ethnic_names['French']['female_names'])
        last_name = random.choice(ethnic_names['French']['last_names'])
    elif race_ethnicity == "Hindu" and primary_language == "Hindi":
        if gender == "Male":
            first_name = random.choice(ethnic_names['Hindu']['male_names'])
        else:
            first_name = random.choice(ethnic_names['Hindu']['female_names'])
        last_name = random.choice(ethnic_names['Hindu']['last_names'])
    else:
        # Default case if no match is found
        if gender == "Male":
            first_name = random.choice(ethnic_names['White']['male_names'])
        else:
            first_name = random.choice(ethnic_names['White']['female_names'])
        last_name = random.choice(ethnic_names['White']['last_names'])
    
    return first_name, last_name

# Apply the function row by row
