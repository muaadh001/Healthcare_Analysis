def generate_prescription_patterns(num_prescriptions=1000000):
    current_date = datetime(2025, 1, 9)
    prescriptions = []
    patient_history = {}
    
    # Business hours distribution
    business_hours = list(range(8, 18))
    hour_weights = [3, 5, 8, 10, 12, 10, 12, 10, 8, 5]
    
    print(f"Generating {num_prescriptions} prescriptions...")
    
    for i in range(num_prescriptions):
        if i % 100000 == 0:
            print(f"Generated {i} prescriptions...")
            
        # Select random provider
        provider = active_providers.sample(1).iloc[0]
        
        try:
            specialty = provider['Specialty']
            specialty_category = provider['Specialty_Category']
            
            # Match drug to provider specialty
            if specialty_category in drugs and specialty in drugs[specialty_category]:
                drug = random.choice(drugs[specialty_category][specialty])
            else:
                drug = random.choice(drugs['Primary Care']['Family Medicine'])
                
        except (KeyError, IndexError):
            specialty = 'Family Medicine'
            specialty_category = 'Primary Care'
            drug = random.choice(drugs['Primary Care']['Family Medicine'])
        
        # Generate prescription details
        patient_id = f"PAT{random.randint(1000000, 9999999)}"
        
        # Generate datetime
        prescription_date = current_date - timedelta(days=random.randint(0, 365))
        hour = random.choices(business_hours[:len(hour_weights)], weights=hour_weights)[0]
        minute = random.randint(0, 59)
        prescription_datetime = prescription_date.replace(hour=hour, minute=minute)
        
        # Generate prescription specifics based on drug type
        quantity, days_supply, dosing_frequency, instructions, refills = generate_rx_details(drug)
        
        prescriptions.append({
            "Prescription_ID": f"RX{random.randint(10000000, 99999999)}",
            "Prescriber_NPI": provider['NPI'],
            "Patient_ID": patient_id,
            "Drug_NDC": drug['NDC'],
            "Drug_Name": drug['Name'],
            "Drug_Type": drug['Type'],
            "Prescription_DateTime": prescription_datetime.strftime("%Y-%m-%d %H:%M"),
            "Quantity_Prescribed": quantity,
            "Days_Supply": days_supply,
            "Fill_Location_ZIP": provider['ZIP'],
            "Prescription_Type": random.choices(["New", "Refill"], weights=[30, 70])[0],
            "Dosing_Frequency": dosing_frequency,
            "Instructions": instructions,
            "Refills_Remaining": refills,
            "DAW_Code": random.choices([0, 1, 2], weights=[80, 15, 5])[0],
            "Prior_Authorization": random.choices(["Yes", "No"], weights=[10, 90])[0],
            "Insurance_Type": random.choice(["Commercial", "Medicare", "Medicaid", "Cash"]),
            "Copay_Amount": random.randint(0, 50) * 5,
            "Prescriber_Specialty": specialty
        })
    
    return pd.DataFrame(prescriptions)

def generate_rx_details(drug):
    """Helper function to generate prescription details"""
    if drug['Type'] == "Antibiotic":
        quantity = random.choice([14, 20, 28, 30])
        days_supply = quantity
        dosing_frequency = random.choice(["BID", "TID", "QID"])
        instructions = f"Take {dosing_frequency} with food for {days_supply} days"
        refills = 0
    elif "Controlled" in drug['Type']:
        quantity = random.choice([30, 60, 90])
        days_supply = 30
        dosing_frequency = random.choice(["QD", "BID", "TID"])
        instructions = f"Take {dosing_frequency} as directed"
        refills = random.randint(0, 5)
    else:
        quantity = random.randint(drug['Common_Quantity'][0], drug['Common_Quantity'][1])
        days_supply = 30 if quantity >= 30 else quantity
        dosing_frequency = random.choice(["QD", "BID"])
        instructions = f"Take {dosing_frequency} as directed"
        refills = random.randint(0, 11)
    
    return quantity, days_supply, dosing_frequency, instructions, refills

